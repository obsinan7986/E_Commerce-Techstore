# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Storage Configuration ─────────────────────────────────────────
# ALLOW_LOCAL_UPLOADS=true permits local disk storage (/uploads) in development only.
# In production on Render/cloud hosts, local storage is ephemeral and disappears.
ALLOW_LOCAL_UPLOADS=true

# ── MongoDB ───────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/TechE-commerce
PRODUCTION_DB_NAME=
ALLOW_DEV_ON_PROD_DB=false

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Chapa payment gateway ─────────────────────────────────────────
CHAPA_SECRET_KEY=your_chapa_secret_key_here

# ── URLs ──────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (Image Storage) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Nodemailer) ────────────────────────────────────────────
# Leave EMAIL_HOST blank to disable real sending (dev mode — logs only)
# For Gmail: use an App Password (not your normal password)
# For Brevo / Mailgun / SendGrid: use their SMTP credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="OBSA_TechStore <noreply@obsatechstore.com>"
